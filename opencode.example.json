{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "mcp": {
    "concord": {
      "type": "local",
      "command": ["npx", "-y", "@concord-ai/concord-mcp@latest"],
      "enabled": true,
      "cwd": ".",
      "environment": {
        "CONCORD_AGENT_KIND": "opencode",
        "CONCORD_AGENT_ID": "{env:CONCORD_AGENT_ID}",
        "CONCORD_TELEMETRY_DISABLED": "1"
      }
    }
  }
}
