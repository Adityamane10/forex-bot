[TEMPLATE]
# Live execution — ALWAYS OFF by default (non-negotiable safety requirement).
# The ExecutionProvider interface exists, but no real order can be placed in
# this build even when this flag is true; paper trading runs in-engine.
ENABLE_LIVE_TRADING=false

# Adaptive polling (REST-only providers). Hot symbols (active signals/candidates)
# poll fast; idle symbols slow; the provider's free-tier budget is never exceeded.
# Optional overrides (ms):
MARKET_POLL_ACTIVE_MS=
MARKET_POLL_IDLE_MS=

# Internal feed ingestion — used by MT5 tick-streaming bridge + MT5 demo trader.
# Set a long random secret to ENABLE always-on MT5 demo execution:
# every auto/manual dashboard trade uses the MT5 demo account's REAL demo
# balance and appears in BOTH places (dashboard + MT5 terminal) with identical
# open/close. INR take-profit (e.g. 100 INR) converts live to USD for MT5;
# P&L deducts from both ledgers. Empty disables MT5 execution (paper-only).
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------------
# Broker account binding — WHICH account the platform trades.
# ---------------------------------------------------------------------------
# The selected account type drives contract size, lot geometry, stop distance,
# spread/commission costs, margin caps and leverage for signal generation,
# predictions and position sizing. Values come from the BOUND MT5 account
# (symbol_info / account_info — the broker's own live answer) and from what you
# confirm on the broker's pages. Unverified terms are shown as unverified and
# hold live dispatch; they are never silently defaulted.
#   ULTRA_LOW_STANDARD (default) | STANDARD | MICRO | XM_ZERO | GENERIC
BROKER_ID=XM
# Empty = the catalog default (XM Ultra Low Standard).
BROKER_ACCOUNT_TYPE=

# Document the broker publishes its account terms on. Polled for CHANGES only:
# a detected change marks the conditions as needing re-confirmation — the
# platform never rewrites its own trading conditions from a fetch. A local path
# or file: URL is accepted for an operator-saved copy (use this when the
# broker's site refuses automated requests).
BROKER_POLICY_URL=https://www.xm.com/account-types
BROKER_POLICY_REFRESH_MS=21600000
# An MT5 heartbeat older than this counts as "not bound" → orders are held.
BROKER_ACCOUNT_MAX_AGE_MS=45000

# REAL-MONEY SWITCH — separate from ENABLE_LIVE_TRADING on purpose. With this
# false, a REAL account may be bound and monitored, but no order can ever be
# dispatched to it. Set on the BACKEND host (the backend gates dispatch) and
# MT5_ALLOW_REAL=1 on the TRADER host for the worker's own independent guard.
ALLOW_REAL_TRADING=false

# ── MetaTrader 5 terminal (the application npm run dev:all launches) ─────────
# `npm run dev:all` starts the MT5 application together with the platform,
# because the bridge and the trader only attach to a RUNNING, LOGGED-IN
# terminal. The install is found automatically; set MT5_PATH only if you keep it
# somewhere unusual, and run `node scripts/mt5-locate.mjs` to see what it found.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_LAUNCH=0          # don't launch the terminal at all
# MT5_WAIT_MS=5000      # settle time after the terminal process appears
# How long the bridge/trader wait for the terminal to load and log in (seconds)
# before giving up — the difference between "attached in 20s" and a watchdog
# respawn cooldown with nothing executing.
MT5_STARTUP_WAIT_S=180

# News — real free RSS feeds by default, no key.
#   NONE no news (safe fallback; system never fabricates news)
#   RSS  free public feeds (InvestingLive/ForexLive, FXStreet, ActionForex,
#        Investing.com Forex), no key, cached 5 min
NEWS_PROVIDER=RSS
NEWS_API_KEY=

# Economic calendar — official central banks + free ForexFactory JSON by default.
#   NONE         no calendar
#   CENTRALBANK  official Fed FOMC / BoE MPC / BoJ MPM / ECB pages merged with
#                the free ForexFactory weekly JSON (default). Each source fails
#                independently; rate decisions 4-6 weeks out are included.
#   FOREXFACTORY free public weekly JSON calendar only, no key
ECONOMIC_CALENDAR_PROVIDER=CENTRALBANK
ECONOMIC_CALENDAR_API_KEY=

# Optional LLM (news summarization / explanation only — never risk controls)
#   Groq free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Python AI engine
PYTHON_AI_URL=http://localhost:8500

# FinBERT financial sentiment (free, open-source, runs locally on the AI engine)
#   Optional: pip install -r ai-engine/requirements-finbert.txt
#   Without it the engine falls back to the financial lexicon (labeled RULE_BASED).
#   The FinBERT model downloads once from Hugging Face (~420 MB).

# Safety switches (defaults are the SAFE values)
#   false: signals require the ML engine; if it is down the engine WAITs
ALLOW_SIGNALS_WITHOUT_ML=false
#   true: the demo (SIMULATED) feed may drive signals if the live feed fails —
#   development only. Keep FALSE for real-market trading: fabricated prices
#   must never produce signals, sizing or profit targets.
ALLOW_DEMO_SIGNALS=false

# Scanner cadence (ms) — safety-net full sweep; event-driven re-analysis
# (candle close / news / calendar) runs immediately, independent of this.
SCANNER_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Indian markets subsystem (backend/src/india, /api/india, India page).
# Real-time data comes ONLY from the configured Indian broker (never Yahoo).
# ---------------------------------------------------------------------------

# Broker. NONE = module runs with no feed (UI shows AUTH_FAILED, no fake data).
#   UPSTOX   Upstox WebSocket v3 (tick-by-tick) + REST market data (recommended)
#   ZERODHA  Zerodha Kite Connect
#   NONE     disabled (default)
INDIA_BROKER=NONE

# Upstox API Analytics Token — free, READ-ONLY, valid ~1 year, market data only.
# Exactly what the paper-trading stage needs: real ticks, candles, quotes;
# cannot place/modify/cancel orders — the system enforces this. Generate it in
# the Upstox developer dashboard: https://upstox.com/developers/ → API Analytics
INDIA_UPSTOX_ANALYTICS_TOKEN=

# Alert delivery - out-of-band notifications for CRITICAL/WARNING alerts
# (flatten-all, reconciliation divergences, breaker trips, worker offline).
# Both channels are optional; alerts are always persisted + shown in the UI.
#   Telegram: create a bot with @BotFather, put the token here and your chat id.
#   Webhook: any JSON POST endpoint (Slack-compatible "text" field included).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
# Minimum severity to deliver: INFO | WARNING | CRITICAL (default WARNING)
ALERT_MIN_SEVERITY=WARNING
ALERT_RATE_LIMIT_PER_MIN=20

# Prometheus metrics surface (GET /api/metrics). Disable with METRICS_ENABLED=false.
METRICS_ENABLED=
